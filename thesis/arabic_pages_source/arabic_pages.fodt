<?xml version="1.0" encoding="UTF-8"?>
<office:document
    xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
    xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
    xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
    xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
    xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
    xmlns:xlink="http://www.w3.org/1999/xlink"
    office:version="1.3"
    office:mimetype="application/vnd.oasis.opendocument.text">

  <office:font-face-decls>
    <style:font-face style:name="Amiri" svg:font-family="Amiri"/>
    <style:font-face style:name="Noto Naskh Arabic" svg:font-family="Noto Naskh Arabic"/>
  </office:font-face-decls>

  <office:automatic-styles>
    <!-- A4 page, with the binding margin on the left -->
    <style:page-layout style:name="pmA4">
      <style:page-layout-properties
          fo:page-width="210mm" fo:page-height="297mm"
          fo:margin-top="1in" fo:margin-bottom="1in"
          fo:margin-left="1.5in" fo:margin-right="1in"
          style:writing-mode="rl-tb"/>
    </style:page-layout>

    <!-- Justified RTL body -->
    <style:style style:name="Body" style:family="paragraph">
      <style:paragraph-properties fo:text-align="justify"
          style:writing-mode="rl-tb" fo:margin-bottom="0.05in"
          fo:line-height="113%"/>
      <style:text-properties style:font-name-complex="Amiri"
          style:font-size-complex="12pt" style:language-complex="ar"
          style:country-complex="EG"/>
    </style:style>

    <!-- Centered heading -->
    <style:style style:name="Heading" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"
          style:writing-mode="rl-tb" fo:margin-bottom="0.10in" fo:margin-top="47pt"/>
      <style:text-properties style:font-name-complex="Amiri"
          style:font-size-complex="18pt" style:font-weight-complex="bold"
          style:language-complex="ar" style:country-complex="EG"/>
    </style:style>

    <!-- Centered normal (title-page lines) -->
    <style:style style:name="Center" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"
          style:writing-mode="rl-tb" fo:margin-bottom="0.09in"
          fo:line-height="132%"/>
      <style:text-properties style:font-name-complex="Amiri"
          style:font-size-complex="14pt" style:language-complex="ar"
          style:country-complex="EG"/>
    </style:style>

    <!-- Centered large bold (title) -->
    <style:style style:name="TitleBig" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"
          style:writing-mode="rl-tb" fo:margin-top="0.14in"
          fo:margin-bottom="0.14in" fo:line-height="130%"/>
      <style:text-properties style:font-name-complex="Amiri"
          style:font-size-complex="19pt" style:font-weight-complex="bold"
          style:language-complex="ar" style:country-complex="EG"/>
    </style:style>

    <!-- Centered bold label -->
    <style:style style:name="CenterBold" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"
          style:writing-mode="rl-tb" fo:margin-top="0.12in"
          fo:margin-bottom="0.05in"/>
      <style:text-properties style:font-name-complex="Amiri"
          style:font-size-complex="14pt" style:font-weight-complex="bold"
          style:language-complex="ar" style:country-complex="EG"/>
    </style:style>

    <!-- Page break before title page (self-contained so alignment is reliable) -->
    <style:style style:name="PageBreak" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"
          style:writing-mode="rl-tb" fo:break-before="page"
          fo:margin-top="0.25in" fo:margin-bottom="0.09in"
          fo:line-height="132%"/>
      <style:text-properties style:font-name-complex="Amiri"
          style:font-size-complex="14pt" style:language-complex="ar"
          style:country-complex="EG"/>
    </style:style>

    <!-- Bold keywords line -->
    <style:style style:name="Keywords" style:family="paragraph">
      <style:paragraph-properties fo:text-align="justify"
          style:writing-mode="rl-tb" fo:margin-top="0.06in"
          fo:line-height="113%"/>
      <style:text-properties style:font-name-complex="Amiri"
          style:font-size-complex="12pt" style:language-complex="ar"
          style:country-complex="EG"/>
    </style:style>
    <!-- Logo frame: same header image and full text width as the English
         title page, so the two title pages open identically. -->
    <style:style style:name="LogoPara" style:family="paragraph">
      <style:paragraph-properties fo:text-align="left"
          style:writing-mode="rl-tb" fo:break-before="page"
          fo:margin-top="0.10in"
          fo:margin-bottom="18.8pt"/>
    </style:style>
    <style:style style:name="LogoFrame" style:family="graphic">
      <style:graphic-properties style:vertical-pos="top"
          style:vertical-rel="paragraph" style:horizontal-pos="center"
          style:horizontal-rel="paragraph" fo:margin-bottom="0.10in"/>
    </style:style>

    <!-- The *** separator, matching the English title page -->
    <style:style style:name="Stars" style:family="paragraph">
      <style:paragraph-properties fo:text-align="center"
          style:writing-mode="rl-tb" fo:margin-top="0.14in"
          fo:margin-bottom="0.10in"/>
      <style:text-properties style:font-name-complex="Amiri"
          style:font-size-complex="14pt" fo:font-size="14pt"
          style:language-complex="ar" style:country-complex="EG"/>
    </style:style>
  <style:style style:name="T16" style:family="paragraph"><style:paragraph-properties fo:text-align="center" style:writing-mode="rl-tb" fo:margin-bottom="0pt" fo:line-height="31.5pt"/><style:text-properties style:font-name-complex="Amiri" style:font-size-complex="16pt" style:language-complex="ar" style:country-complex="EG"/></style:style><style:style style:name="T16Date" style:family="paragraph"><style:paragraph-properties fo:text-align="center" style:writing-mode="rl-tb" fo:margin-bottom="0pt" fo:line-height="31.5pt" fo:margin-top="17.1pt"/><style:text-properties style:font-name-complex="Amiri" style:font-size-complex="16pt" style:language-complex="ar" style:country-complex="EG"/></style:style><style:style style:name="T16B" style:family="paragraph"><style:paragraph-properties fo:text-align="center" style:writing-mode="rl-tb" fo:margin-bottom="0pt" fo:line-height="31.5pt"/><style:text-properties style:font-name-complex="Amiri" style:font-size-complex="16pt" style:font-weight-complex="bold" style:language-complex="ar" style:country-complex="EG"/></style:style><style:style style:name="T16Break" style:family="paragraph"><style:paragraph-properties fo:text-align="center" style:writing-mode="rl-tb" fo:break-before="page" fo:margin-top="11pt" fo:margin-bottom="8.5pt" fo:line-height="23pt"/><style:text-properties style:font-name-complex="Amiri" style:font-size-complex="16pt" style:font-weight-complex="bold" style:language-complex="ar" style:country-complex="EG"/></style:style><style:style style:name="C14" style:family="paragraph"><style:paragraph-properties fo:text-align="center" style:writing-mode="rl-tb" fo:margin-bottom="0pt" fo:line-height="28.5pt"/><style:text-properties style:font-name-complex="Amiri" style:font-size-complex="14pt" style:language-complex="ar" style:country-complex="EG"/></style:style><style:style style:name="C14B" style:family="paragraph"><style:paragraph-properties fo:text-align="center" style:writing-mode="rl-tb" fo:margin-bottom="0pt" fo:line-height="20pt"/><style:text-properties style:font-name-complex="Amiri" style:font-size-complex="14pt" style:font-weight-complex="bold" style:language-complex="ar" style:country-complex="EG"/></style:style><style:style style:name="R14B" style:family="paragraph"><style:paragraph-properties fo:text-align="start" style:writing-mode="rl-tb" fo:margin-top="0pt" fo:margin-bottom="0pt" fo:line-height="31pt"/><style:text-properties style:font-name-complex="Amiri" style:font-size-complex="14pt" style:font-weight-complex="bold" style:language-complex="ar" style:country-complex="EG"/></style:style><style:style style:name="R14" style:family="paragraph"><style:paragraph-properties fo:text-align="start" style:writing-mode="rl-tb" fo:margin-bottom="0pt" fo:line-height="22pt"/><style:text-properties style:font-name-complex="Amiri" style:font-size-complex="14pt" style:font-weight-complex="bold" style:language-complex="ar" style:country-complex="EG"/></style:style><style:style style:name="RRule" style:family="paragraph"><style:paragraph-properties fo:text-align="start" style:writing-mode="rl-tb" fo:margin-top="12pt" fo:margin-bottom="0pt" fo:line-height="22pt"/><style:text-properties style:font-name-complex="Amiri" style:font-size-complex="14pt" style:language-complex="ar" style:country-complex="EG"/></style:style><style:style style:name="RRuleFirst" style:family="paragraph"><style:paragraph-properties fo:text-align="start" style:writing-mode="rl-tb" fo:margin-top="6pt" fo:margin-bottom="0pt" fo:line-height="22pt"/><style:text-properties style:font-name-complex="Amiri" style:font-size-complex="14pt" style:language-complex="ar" style:country-complex="EG"/></style:style></office:automatic-styles>

  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="pmA4"/>
  </office:master-styles>

  <office:body><office:text><text:p text:style-name="Heading">الملخص</text:p><text:p text:style-name="Body">قدّم معيار SQL:2016 جملة MATCH_RECOGNIZE للتعرّف على أنماط الصفوف، وهي تبحث عن نمط محدَّد داخل أقسام مرتَّبة من الصفوف باستخدام تعبيرات نمطية. وتبرز أهميتها في مجالات مثل كشف الاحتيال ومراقبة إنترنت الأشياء وسلاسل النقرات في التجارة الإلكترونية، حيث تتمثّل المعلومة المهمة في سلسلة من الأحداث لا في سجلٍّ منفرد. وتوفّر أنظمة مثل Oracle وTrino هذه الخاصية، بينما تفتقر مكتبة Pandas إلى دعمٍ أصيل لها، فيلجأ المحلّلون إلى الأعمدة المزاحة والحلقات اليدوية وإدارة الحالة المخصّصة، مما يجعل الشيفرة أطول وأقلّ قابلية للقراءة وأكثر عرضة للأخطاء. ولسدّ هذه الفجوة، يقوم المحرّك المقترح بتحليل استعلامات MATCH_RECOGNIZE المكتوبة بلغة SQL، وبناء تمثيلٍ منظَّم لها، والتحقّق من صحة جملها، وترجمة تعبيرات النمط إلى آلاتٍ منتهية، وتنفيذ المطابقة على أقسام DataFrame المرتَّبة، بما يغطّي نطاق الخاصية R010 المُقيَّمة: PARTITION BY وORDER BY وPATTERN وDEFINE وMEASURES وأنماط التخطي والإخراج والمحدّدات الكمية والتناوب والتجميع والاستثناءات والمراسي والتباديل ودوالّ تنقّلٍ وتجميعٍ مختارة. وقد اجتازت جميع اختبارات الانحدار البالغ عددها 709 اختبارًا. وجرى التقييم بخمسة معايير: صحة النتائج مقارنةً بمخرجات Trino وOracle، وتغطية خصائص المعيار، وسهولة الاستخدام، والأداء، وقابلية التوسّع. استخدم القياس المرجعي بيانات منتجات أمازون بالمملكة المتحدة لعام 2023 حتى 2.22 مليون صف، واستخدم اختبار قابلية التوسّع تقييمات أمازون لعام 2023 حتى 227.9 مليون صف تحت نواة معالجٍ واحدة وحدٍّ للذاكرة قدره 58 جيجابايت. وأعاد المحرّك إنتاج المخرجات المرجعية صفًّا بصفّ في خلايا المقارنة الثلاثين جميعها، وسجّل، تحت نواة معالجٍ واحدة وحدٍّ للذاكرة قدره 32 جيجابايت، أدنى متوسّط زمن تنفيذ بين الأنظمة الثلاثة: 0.17 ثانية مقابل 1.04 ثانية لنظام Oracle و1.98 ثانية لنظام Trino، مع قابلية توسّعٍ شبه خطية. وأكمل المحرّك ونظام Oracle الحالات الخمس والثلاثين جميعها، بينما أكمل Trino ثلاثًا وثلاثين حالة. وتُظهر هذه النتائج أنّ جلب وظيفة MATCH_RECOGNIZE إلى Pandas يمكن أن يجسر بين مسارات عمل SQL وPython، ويجعل تحليل البيانات التسلسلية أكثر قابلية للقراءة والنقل.</text:p><text:p text:style-name="Keywords">الكلمات المفتاحية: التعرّف على أنماط الصفوف؛ مطابقة الأنماط؛ الآلات المنتهية؛ تحليل البيانات التسلسلية؛ الاستعلامات التصريحية؛ إطارات البيانات.</text:p><text:p text:style-name="T16Break">استخراج أنماط السجلات التسلسلية: تعزيز إطارات بيانات بانداس بتنفيذ آلية التعرف على الأنماط</text:p><text:p text:style-name="T16">إعداد</text:p><text:p text:style-name="T16B">منير أشرف منير لوندي</text:p><text:p text:style-name="C14">رسالة مقدمة إلى كلية تكنولوجيا المعلومات وعلوم الحاسب، جامعة النيل الأهلية</text:p><text:p text:style-name="C14">كجزء من متطلبات الحصول على درجة</text:p><text:p text:style-name="C14">ماجستير العلوم</text:p><text:p text:style-name="C14">في</text:p><text:p text:style-name="C14B">المعلوماتية</text:p><text:p text:style-name="R14B">لجنة الإشراف:</text:p><text:p text:style-name="RRuleFirst">________________________</text:p><text:p text:style-name="R14">المشرف الرئيسي</text:p><text:p text:style-name="R14">أ.د. محمد الحلو، أستاذ بكلية تكنولوجيا المعلومات وعلوم الحاسب، جامعة النيل الأهلية</text:p><text:p text:style-name="RRule">________________________</text:p><text:p text:style-name="R14">مشرف</text:p><text:p text:style-name="R14">د. أحمد عوض، أستاذ مشارك بالجامعة البريطانية في دبي، الإمارات، وجامعة القاهرة، مصر</text:p><text:p text:style-name="LogoPara"><draw:frame draw:style-name="LogoFrame" text:anchor-type="as-char" svg:width="6.03cm" svg:height="1.62cm" draw:z-index="0"><draw:image><office:binary-data></office:binary-data></draw:image></draw:frame></text:p><text:p text:style-name="T16B">استخراج أنماط السجلات التسلسلية: تعزيز إطارات بيانات بانداس بتنفيذ آلية التعرف على الأنماط</text:p><text:p text:style-name="T16">إعداد</text:p><text:p text:style-name="T16B">منير أشرف منير لوندي</text:p><text:p text:style-name="C14">رسالة مقدمة إلى كلية تكنولوجيا المعلومات وعلوم الحاسب، جامعة النيل الأهلية</text:p><text:p text:style-name="C14">كجزء من متطلبات الحصول على درجة</text:p><text:p text:style-name="C14">ماجستير العلوم</text:p><text:p text:style-name="C14">في</text:p><text:p text:style-name="C14B">المعلوماتية</text:p><text:p text:style-name="T16Date">تاريخ</text:p><text:p text:style-name="T16B">سبتمبر/2026</text:p></office:text></office:body>
</office:document>
